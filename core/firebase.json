{
  "firestore": {
    "rules": "firestore.rules",
    "location": "asia-south1",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "core",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "scripts",
        "service-account.json",
        "keys"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
