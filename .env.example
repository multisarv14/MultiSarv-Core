# .env.local madhe copy kara: cp .env.example .env.local
#
# Firebase Console → Project settings → General → "Your apps" → Add app → Web (</>)
# → tithla firebaseConfig ithe taka. (Web config public aahe — secret nahi;
# suraksha Firestore rules + core ne dilelya token che claims ne hote.)
#
# Mahatvache: Android app chi apiKey vaparu naka — ti Android apps la restricted
# aste, browser madhun "API key not valid" yeil. Web app vegla register kara.

# Khare values fakt .env.local madhe (git madhe jat nahi). Ithe rikame theva.

# ── Multisarv core (admins + access) — email/password login ──
# Core Firebase project → Project settings → Your apps → Web app config.
VITE_CORE_API_KEY=
VITE_CORE_AUTH_DOMAIN=multisarv-core.firebaseapp.com
VITE_CORE_PROJECT_ID=multisarv-core
VITE_CORE_STORAGE_BUCKET=multisarv-core.firebasestorage.app
VITE_CORE_MESSAGING_SENDER_ID=
VITE_CORE_APP_ID=
# Core Cloud Functions region (default asia-south1)
# VITE_CORE_REGION=asia-south1

# ── NOAI (noai-17bdc) ──
VITE_NOAI_API_KEY=
VITE_NOAI_AUTH_DOMAIN=noai-17bdc.firebaseapp.com
VITE_NOAI_PROJECT_ID=noai-17bdc
VITE_NOAI_STORAGE_BUCKET=noai-17bdc.firebasestorage.app
VITE_NOAI_MESSAGING_SENDER_ID=
VITE_NOAI_APP_ID=
# Admin browser push: Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_NOAI_VAPID_KEY=

# ── Navin project (src/config/projects.ts madhe entry add kelyavar) ──
# VITE_VIJAYDHARA_API_KEY=
# VITE_VIJAYDHARA_AUTH_DOMAIN=
# VITE_VIJAYDHARA_PROJECT_ID=
# VITE_VIJAYDHARA_STORAGE_BUCKET=
# VITE_VIJAYDHARA_MESSAGING_SENDER_ID=
# VITE_VIJAYDHARA_APP_ID=

# ── Local emulator (optional) ──
# noai madhe `firebase emulators:start` chalu asel tar panel tyala connect hoto.
# VITE_USE_EMULATORS=true
# VITE_EMULATOR_HOST=127.0.0.1
